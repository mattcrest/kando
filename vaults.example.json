      "canonicalRepo": "your-org/venubase-roadmap"
    },
    "playerpath": {
      "workspaceRoots": [
        "/absolute/path/to/playerpath-web",
        "/absolute/path/to/playerpath-web-pr*",
        "/absolute/path/to/playerpath/worktrees/*"
      ],
      "conventionsFile": "roadmap-conventions.md",
